# ============================================================
# Pi Network - Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values.
# .env.local is ignored by Git (see .gitignore) so your secrets stay safe.
# ============================================================

# --- Client-side (public, safe to expose in browser) ---
# Your Pi App ID from the Pi Developer Dashboard (https://developers.pi.computer/)
# Found in: Your App → Sandbox → Configuration Payload
NEXT_PUBLIC_PI_APP_ID=your_pi_app_id_here

# --- Server-side (SECRET - never expose to the client) ---
# Pi Network Server API Key used by app/api/auth/pi/route.ts
# to approve and complete payments.
# Found in: Pi Developer Dashboard → Your App → API Keys
PI_API_KEY=your_pi_server_api_key_here

# --- Optional ---
# Override the callback URL used by the Pi SDK
# NEXT_PUBLIC_CALLBACK_URL=http://localhost:3000

